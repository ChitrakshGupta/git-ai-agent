# Copy to backend/.env. Only GEMINI_API_KEY is required for "Review a PR link".

# ── AI: Google Gemini (free tier) ── https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: models tried in order; a 429/503/timeout moves on to the next one
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# GEMINI_TIMEOUT_S=60
# AGENT_MAX_TURNS=8

# ── Optional: GitHub token for signed-out PR-link reviews (raises 60 -> 5000 requests/hour)
# GITHUB_TOKEN=

# ── "Auto-review repos" (GitHub OAuth + webhook) ──
# OAuth App callback URL must be: {BACKEND_URL}/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=any_long_random_string

# ── Database ── leave empty for a local SQLite file; Neon/Postgres in production:
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db?ssl=require
DATABASE_URL=

JWT_SECRET=change_me_to_at_least_32_random_characters

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Public URL GitHub can reach for webhooks (your ngrok https URL in local dev)
# WEBHOOK_URL=https://xxxx.ngrok-free.app
# Or let the backend open an ngrok tunnel itself (needs NGROK_AUTHTOKEN):
# ENABLE_NGROK=true
# NGROK_AUTHTOKEN=
